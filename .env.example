# ============================================================
# AlphaEdge Capital AI — Environment Configuration Template
# Copy this file to .env and fill in your OWN API keys.
#   copy .env.example .env
# NEVER commit .env — it is listed in .gitignore.
# ============================================================

# ---- LLM: NVIDIA-hosted (Modal-compatible) endpoint ---------
# Key: https://build.nvidia.com
MODAL_API_KEY=your_modal_api_key_here
MODAL_BASE_URL=https://integrate.api.nvidia.com/v1
MODAL_MODEL=moonshotai/kimi-k3

# ---- LLM: GitHub Models (fallback) --------------------------
# Token: https://github.com/settings/tokens
GITHUB_MODELS_TOKEN=your_github_models_token_here
GITHUB_MODELS_MODEL=gpt-4o-mini

# ---- LLM: Google Gemini (free tier) -------------------------
# Get free key at: https://aistudio.google.com/app/apikey
# No credit card required. 1,500 free requests/day.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ---- LLM: Groq (free tier) ---------------------------------
# Get free key at: https://console.groq.com/keys
# No credit card required. 14,400 free requests/day.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ---- LLM: Ollama (offline local fallback) ------------------
# Download from: https://ollama.com (free, open-source)
# Run: ollama pull llama3.2 && ollama serve
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# ---- Market data: Finnhub ----------------------------------
# Get free key at: https://finnhub.io/register
# No credit card required. 60 API calls/min free forever.
FINNHUB_API_KEY=your_finnhub_api_key_here

# ---- IC MARKETS / METATRADER 5 (MT5) ----------------------
# Set to 'true' to enable real trading on MT5
LIVE_TRADING_ENABLED=false
MT5_LOGIN=your_account_number
MT5_PASSWORD=your_password
MT5_SERVER=ICMarketsSC-Demo
# Optional: Path to terminal.exe (if auto-launch is desired)
MT5_TERMINAL_PATH=C:/Program Files/IC Markets MetaTrader 5/terminal64.exe

# ---- Capital -----------------------------------------------
STARTING_CAPITAL=10000.00
EQUITY_ALLOCATION_PCT=0.00
FOREX_ALLOCATION_PCT=1.00

# ---- Free Tier Rate Limit Budgets (80% safety margin) ------
GEMINI_DAILY_LIMIT=1200
GROQ_DAILY_LIMIT=11520

# ---- Risk Rules --------------------------------------------
MAX_SINGLE_TRADE_RISK_PCT=0.03
MAX_PORTFOLIO_DRAWDOWN_PCT=0.15
MAX_TOTAL_OPEN_POSITIONS=20
MAX_EQUITY_OPEN_POSITIONS=5
MAX_FOREX_OPEN_POSITIONS=15
MIN_RISK_REWARD_RATIO=1.5

# ---- Equity Settings ---------------------------------------
MAX_EQUITY_POSITION_PCT=0.20
EQUITY_VOLATILITY_ATR_FILTER=0.05
EQUITY_CYCLE_MINUTES=60
EQUITY_WATCHLIST=

# ---- Forex Settings ----------------------------------------
MAX_FOREX_LEVERAGE=20
MAX_LOT_SIZE=0.5
MANUAL_LOT_SIZE_ENABLED=false
FIXED_LOT_SIZE=0.01
NEWS_SHIELD_MINUTES=30
MAX_PIP_STOP_LOSS=50
MAX_SPREAD_PIPS=3.0
FX_CYCLE_MINUTES=30
FX_WATCHLIST=EURUSD=X,EURGBP=X,EURJPY=X,EURAUD=X,EURNZD=X,EURCAD=X,GBPJPY=X,GBPUSD=X,GBPAUD=X,GBPNZD=X,GBPCAD=X,AUDJPY=X,AUDCAD=X,AUDNZD=X,NZDJPY=X,CADJPY=X,CHFJPY=X

# ---- General -----------------------------------------------
MAX_STRATEGY_REVISION_ROUNDS=3
POSITION_MONITOR_SECONDS=300

# ---- Security: self-healing endpoints ----------------------
# Shared secret required in the X-Healing-Token header for
# /api/healing/diagnose, /api/healing/heal and /api/healing/history.
# Fail-closed: if this is empty the endpoints return 503 and stay disabled.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
HEALING_TOKEN=your_healing_token_here

# ============================================================
# ---- Antigravity Data Layer (OpenBB Platform v4) -----------
# ============================================================

# ---- OpenBB Hub (optional) ---------------------------------
# Syncs API keys across devices — get PAT at: https://my.openbb.co
OPENBB_PAT=your_openbb_pat_here

# ---- Financial Modeling Prep (FMP) -------------------------
# Get FREE key (250 req/day) at: https://financialmodelingprep.com/developer/docs/
FMP_API_KEY=your_fmp_api_key_here

# ---- Polygon.io (real-time + order book) -------------------
# Get FREE key (unlimited delayed) at: https://polygon.io/dashboard/signup
POLYGON_API_KEY=your_polygon_api_key_here

# ---- FRED (Federal Reserve — macro indicators) -------------
# Get FREE key at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# ---- Alpha Vantage (technical indicators fallback) ---------
# Get FREE key (25 req/day) at: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=your_alphavantage_api_key_here

# ---- Tiingo (news + alternative OHLCV) ---------------------
# Get FREE key at: https://www.tiingo.com/account/api/token
TIINGO_API_KEY=your_tiingo_api_key_here

# ---- Provider Preferences ----------------------------------
DEFAULT_EQUITY_PROVIDER=yfinance
DEFAULT_FUNDAMENTAL_PROVIDER=fmp
DEFAULT_MACRO_PROVIDER=fred
DEFAULT_NEWS_PROVIDER=tiingo

# ---- Data Cache --------------------------------------------
CACHE_TTL_SECONDS=900
CACHE_DB_PATH=data_layer/cache/market_data.db
